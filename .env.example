# Copia este archivo como .env y reemplaza el marcador antes de iniciar Docker.
POSTGRES_USER=asistencia
POSTGRES_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_LOCAL
POSTGRES_DB=asistencia
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Deja estas URLs vacías para usar las bases locales de Docker.
# En producción, configúralas como variables privadas en el proveedor.
POSTGRES_URL=
MONGO_URL=
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_REPLICA_SET=rs0

# Orígenes del servidor estático local del panel.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Configuración que usa el módulo local si BACKEND_WS no está definido.
BACKEND_WS_HOST=localhost:8000
BACKEND_WS_SECURE=false
ID_CURSO=1
ID_DISPOSITIVO=salon-101
